# Copy to .env and fill in. Never commit the filled copy.

# Transcription (ElevenLabs Scribe). Leave unset to run the mock ASR provider —
# fake words, real timings, and every downstream stage runs for real at zero cost.
ELEVENLABS_API_KEY=

# Optional alternative transcription provider. When both this and ElevenLabs are
# configured, choose the automatic-import provider in Library > On import.
SARVAM_API_KEY=

# Force the mock provider even when a key is present.
# ASR_PROVIDER=mock

# Image inserts (Gemini "Nano Banana 2"). Describe a picture and it is generated
# at this video's own aspect ratio, then placed on the words you described.
# Leave unset and the Images panel offers file import only — nothing else changes.
GEMINI_API_KEY=

PORT=8787

# Where uploads, renders and project JSON live. Point at a mounted volume in
# production; the default sits inside the source tree.
# MEDIA_DIR=/data

# Serve the built UI from this server. Unset in dev (Vite serves it).
# WEB_DIST=./apps/web/dist

# Browser origin allowed to call the API. Unset means any origin — fine locally,
# unsafe in production while the API is unauthenticated.
# CORS_ORIGIN=https://editor.example.com

# Upload ceiling. The import route buffers the whole file in memory.
# MAX_UPLOAD_MB=512
