<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Loopback HTTP to the in-process server, plus real network for ASR /
         music search / Grok when the user has keys. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- M3: foreground service keeps renders alive when the app is backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Jumpstart"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:largeHeap="true">
        <!-- extractNativeLibs + jniLibs.useLegacyPackaging (gradle) are the pair
             that lands libffmpeg.so/libffprobe.so as executable REAL FILES in
             nativeLibraryDir. Both stay, belt and braces across AGP versions.
             largeHeap: computePeaks buffers full decoded PCM; the WebView holds
             filmstrip sheets. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density">
            <!-- configChanges: a rotation must not recreate the Activity — that
                 would tear down the WebView (losing editor state) while the
                 in-process Node server keeps running. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
