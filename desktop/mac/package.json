{
  "name": "transcript-editor",
  "productName": "Transcript Editor",
  "version": "0.1.0",
  "description": "Edit video and audio by editing the transcript.",
  "author": "You <you@example.com>",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run tools -- --arch=arm64 --cpu=arm64 && npm run build && electron-builder --mac --arm64",
    "dist:intel": "npm run tools -- --arch=x64 --cpu=x64 && npm run build && electron-builder --mac --x64",
    "tools": "npm install --force ffmpeg-static @ffprobe-installer/ffprobe"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2"
  },
  "build": {
    "appId": "com.example.transcript-editor",
    "productName": "Transcript Editor",
    "directories": {
      "output": "dist"
    },
    "afterPack": "afterPack.cjs",
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  }
}
